// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  password      String?
  // ── Социальные поля ──────────────────────────────────
  handle        String?       @unique  // уникальный @тег, напр. "john_doe"
  bio           String?
  avatarColor   String        @default("#6366f1")
  isPublic      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  // ── Связи ────────────────────────────────────────────
  habits        Habit[]
  tasks         Task[]
  habitLogs     HabitLog[]
  taskLogs      TaskLog[]
  pomodoroLogs  PomodoroLog[]
  settings      UserSettings?
  notes         Note[]
  // Чат
  conversationsA Conversation[] @relation("ConvUserA")
  conversationsB Conversation[] @relation("ConvUserB")
  sentMessages   Message[]      @relation("MessageSender")
}

model UserSettings {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workMin     Int     @default(25)
  shortMin    Int     @default(5)
  longMin     Int     @default(15)
}

model Habit {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String     @default("🌿")
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  logs      HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  done      Boolean  @default(true)

  @@unique([habitId, date])
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String    @default("personal")
  priority  String    @default("med")
  done      Boolean   @default(false)
  date      String
  createdAt DateTime  @default(now())
  logs      TaskLog[]
}

model TaskLog {
  id      String  @id @default(cuid())
  taskId  String
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    String
  done    Boolean

  @@unique([taskId, date])
}

model PomodoroLog {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    String
  count   Int    @default(0)

  @@unique([userId, date])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Без названия")
  content   String   @default("")
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Личные переписки (1-to-1) ─────────────────────────────
model Conversation {
  id        String    @id @default(cuid())
  userAId   String
  userBId   String
  userA     User      @relation("ConvUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User      @relation("ConvUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  messages  Message[]

  // Пара уникальна независимо от порядка (решается на уровне API)
  @@unique([userAId, userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  text           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?
}
